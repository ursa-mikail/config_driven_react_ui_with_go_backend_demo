#!/bin/sh
# Creates frontend/package-lock.json and backend/go.sum so builds are reproducible. Run once, commit both.
cd "$(dirname "$0")" || exit 1
docker run --rm -v "$PWD/frontend:/app" -w /app node:20-alpine npm install --package-lock-only --no-audit --no-fund || exit 1
docker run --rm -v "$PWD/backend:/src" -w /src golang:1.22-alpine go mod tidy || exit 1
printf "\n  Lockfiles written: frontend/package-lock.json and backend/go.sum\n\n"
